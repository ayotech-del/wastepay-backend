# Local development. Use PostgreSQL and ENVIRONMENT=production for deployment.
DATABASE_URL=sqlite:///./wastepay_dev.db
ENVIRONMENT=development
SECRET_KEY=
CORS_ORIGINS=http://localhost:3000,http://localhost:8300
# Set only real test-mode credentials during development.
PAYSTACK_SECRET_KEY=
TELEMETRY_KEY=
# Deferred provider integrations; not activated by supplying a key alone.
PREMBLY_API_KEY=
AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_API_KEY=
